		"esbuild": "0.25.0",
		"obsidian": "1.11.4",
		"tslib": "2.4.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@codemirror/language": "^6.9.2",
		"@codemirror/state": "6.5.0",
